# Copy to .env for local development. Production values are set in Vercel, see docs/DEPLOY.md.

# Neon Postgres - pooled connection string of the `dev` branch locally, `main` branch in production
# https://console.neon.tech
DATABASE_URL=

# Better Auth - generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a different secret per environment.
BETTER_AUTH_SECRET=
# No trailing slash. Production: https://<prod-domain>
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app - one app per environment, created at https://github.com/settings/developers
# Authorization callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public site URL for canonical links, sitemap, OG image (src/lib/site.ts). Optional locally, required in production.
# NEXT_PUBLIC_SITE_URL=https://<prod-domain>
