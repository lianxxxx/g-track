# Neon Postgres - create a project at https://console.neon.tech and paste the pooled connection string
DATABASE_URL=

# Better Auth - generate a secret with: npx @better-auth/cli secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app - create at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
